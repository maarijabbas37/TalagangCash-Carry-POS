# Database
POSTGRES_USER=talagang
POSTGRES_PASSWORD=change_me
POSTGRES_DB=talagang_pos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://talagang:change_me@db:5432/talagang_pos

# Auth
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Store config
STORE_NAME=TALAGANG CASH & CARRY
STORE_ADDRESS=Talagang, Punjab, Pakistan
STORE_PHONE=03XX-XXXXXXX
DEFAULT_CURRENCY=PKR

# App
ENVIRONMENT=development
ALLOW_NEGATIVE_STOCK=false
LOW_STOCK_DEFAULT=15

# Seed admin (used only by seed.py, first run). full_name defaults to
# the username itself if not set — never assume a specific person's name.
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_PASSWORD=change_me_immediately
SEED_ADMIN_FULL_NAME=owner
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD=change_me_too
SEED_EMPLOYEE_FULL_NAME=employee
